{
  "appId": "com.learnx.app",
  "appName": "LearnX",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0F172A",
      "showSpinner": true,
      "spinnerColor": "#6366F1"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0F172A"
    }
  }
}
